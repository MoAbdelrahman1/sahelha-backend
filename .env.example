# Copy to .env and fill in real values. EXPO_PUBLIC_ vars are bundled into the
# app and are NOT secret (see lib/config.ts) — fine for a base URL, never put
# real secrets here.
EXPO_PUBLIC_API_BASE_URL=https://REPLACE_ME

# Optional — fall back to sensible defaults in lib/config.ts when unset.
# EXPO_PUBLIC_API_TIMEOUT_MS=15000
# EXPO_PUBLIC_API_MAX_RETRIES=3
# EXPO_PUBLIC_API_RETRY_BASE_DELAY_MS=500
